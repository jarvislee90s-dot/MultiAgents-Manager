{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MultiAgents Manager",
  "mainBinaryName": "multi-agents-manager",
  "version": "0.2.2",
  "identifier": "com.jarvis.multiagents-manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4RUVGNjc2NzI5NDZEQwpSV1RjUmlsblorK09CbkNkb1Q1WWZuRUtDdmpWNXhmdjRGblB1REZmYmRmODNmNUErWlNtVG5hZAo=",
      "endpoints": [
        "https://github.com/jarvislee90s-dot/MultiAgents-Manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MultiAgents Manager",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
